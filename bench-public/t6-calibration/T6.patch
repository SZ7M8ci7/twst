+test('worker watcher matching fails closed for missing or modified side effects and duplicate blocks',()=>{const once=transform(vue);assert.throws(()=>transform(once),/exactly one/);assert.throws(()=>transform(vue.replace('if (isRunning.value) requestSimulationStop();','if (isRunning.value) { requestSimulationStop(); }')),/exactly one/);assert.throws(()=>transform(vue+'\n'+vue),/exactly one/);});

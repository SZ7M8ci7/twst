diff --git a/build/examAutoBestWorkerHostPlugin.mts b/build/examAutoBestWorkerHostPlugin.mts
index 67111e04..487f4b1c 100644
--- a/build/examAutoBestWorkerHostPlugin.mts
+++ b/build/examAutoBestWorkerHostPlugin.mts
@@ -30,6 +30,15 @@ export function examAutoBestWorkerHostPlugin(): Plugin {
         genDefaultAs: '__examAutoBestWorkerHost',
       }).content
 
+      // The headless host never starts the interactive screen run. Its explicit
+      // worker stop protocol remains intact; display invalidation need not deep-
+      // traverse the full reactive deck after every resource candidate prepare.
+      const displayInvalidationWatch = /watch\(\s*\[exam, enemySlots, deck, turnPlans, selectedSpecialChallengeIds, favorableEffects, forceFinisherTripleCritical\],\s*\(\) => \{\s*clearResults\(\);\s*if \(isRunning\.value\) requestSimulationStop\(\);\s*\},\s*\{ deep: true \},?\s*\);/g
+      if ([...code.matchAll(displayInvalidationWatch)].length !== 1) {
+        throw new Error('Expected exactly one headless display-invalidation watcher')
+      }
+      code = code.replace(displayInvalidationWatch, '')
+
       code = code
         .replace("import ExamSearchPanel from '@/components/ExamSearchPanelLoader.vue';", 'const ExamSearchPanel = null;')
         .replace("import { Bar } from 'vue-chartjs';", 'const Bar = null;')

+const assert=require('node:assert/strict'),{test}=require('node:test'),fs=require('node:fs'),path=require('node:path'),vm=require('node:vm'),ts=require('typescript');
+const src=fs.readFileSync(path.join(__dirname,'../../src/views/examSimulator.vue'),'utf8').match(/<script setup lang="ts">([\s\S]*?)<\/script>/)[1];
+const ast=ts.createSourceFile('exam.ts',src,ts.ScriptTarget.Latest,true),f=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name.text==='hasPlayerUtilityEffect');assert.ok(f);
+const context={};vm.createContext(context);vm.runInContext(ts.transpileModule(f.getText(ast),{compilerOptions:{target:ts.ScriptTarget.ES2021}}).outputText,context);
+const current=(labels,heal)=>context.hasPlayerUtilityEffect(labels.map(buffOption=>({buff:{buffOption}})),heal);
+const reference=(labels,heal)=>/解除|無効/.test(`${labels.join(' ')} ${heal}`);
+test('T4 exact join-predicate equivalence for boundary, null, undefined and Japanese labels',()=>{
+ const values=['','解','除','無','効','解除','無効','解 除','無 効','回復','回復解除','無効化','\n解除\n','解\n除','x解除x','😀無効',null,undefined,0,false];
+ let checked=0;for(const a of values)for(const b of values)for(const h of values){assert.equal(current([a,b],h),reference([a,b],h),JSON.stringify([a,b,h]));checked++;}assert.equal(checked,8000);
+ for(const h of values)assert.equal(current([],h),reference([],h));
+});
+test('T4 utility remains one boolean for repeated matching labels; separators prevent cross-boundary token matches',()=>{
+ assert.equal(current(['解除','無効','解除'],'解除'),true);assert.equal(Number(current(['解除','無効'],'無効')),1);
+ assert.equal(current(['解','除'],'無 効'),false);assert.equal(current(['無'],'効'),false);
+});

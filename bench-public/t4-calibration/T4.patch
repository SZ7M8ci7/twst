+// Joined labels are separated by a space, which cannot occur inside either
+// literal token. Preserve the boolean (one utility increment), not match count.
+function hasPlayerUtilityEffect(plans: ReturnType<typeof getPlayerEffectPlans>, healing: string) {
+  return plans.some(plan => /解除|無効/.test(plan.buff.buffOption)) || /解除|無効/.test(healing);
+}

+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {runtime,state}=require('./helpers/exam-runtime.cjs');
+function reference(c,b) {
+ const kind=b.buffOption,power=b.powerOption,level=Math.min(10,Math.max(1,Math.floor(c.safeNumber(b.levelOption)||10)));
+ let atkRate=0,damageRate=0,criticalRate=0;
+ if(kind==='ATKUP'||kind==='ATKDOWN')atkRate=c.safeNumber(c.atkbuffDict[`${kind}(${power})${level}`]);
+ else if(['ダメージUP','ダメージDOWN','属性ダメUP','属性ダメDOWN'].includes(kind)) {
+  const prefix=kind==='ダメージUP'?'ダメUP':kind==='ダメージDOWN'?'ダメDOWN':kind;
+  damageRate=c.safeNumber(c.dmgbuffDict[`${prefix}(${power})${level}`]);
+ }else if(kind==='クリティカル')criticalRate=c.criticalChanceFromPower(power);
+ return {kind,power,rawLevel:b.levelOption,atkRate,damageRate,criticalRate};
+}
+function context(){const c=runtime();c.atkbuffDict={};c.dmgbuffDict={};for(const kind of ['ATKUP','ATKDOWN','ダメUP','ダメDOWN','属性ダメUP','属性ダメDOWN'])for(const p of ['小','中','大'])for(let l=1;l<=10;l++){c.atkbuffDict[`${kind}(${p})${l}`]=l/100;c.dmgbuffDict[`${kind}(${p})${l}`]=l/200;}c.simulationRuntimeCache={playerBuffCoefficients:new WeakMap()};return c;}
+test('T3 coefficients match direct formula over descriptors and normalization boundaries',()=>{
+ const c=context();let n=0;
+ for(const kind of ['ATKUP','ATKDOWN','ダメージUP','ダメージDOWN','属性ダメUP','属性ダメDOWN','クリティカル','unknown'])for(const power of ['小','中','大','unknown'])for(const level of [undefined,null,NaN,-1,0,1,2.4,9,10,11,'7',Infinity]){
+  const b={buffOption:kind,powerOption:power,levelOption:level};const first=c.playerBuffCoefficients(b);
+  assert.deepEqual({...first},reference(c,b));const second=c.playerBuffCoefficients(b);
+  if(!Number.isNaN(level))assert.equal(first,second);n++;
+ }assert.equal(n,384);
+});
+test('T3 invalidates mutable raw coefficient fields and runtime replacement',()=>{
+ const c=context(),b={buffOption:'ATKUP',powerOption:'小',levelOption:1};let last=c.playerBuffCoefficients(b);
+ for(const edit of [{levelOption:10},{powerOption:'大'},{buffOption:'ダメージUP'},{buffOption:'ATKUP',powerOption:'小',levelOption:1}]){Object.assign(b,edit);const now=c.playerBuffCoefficients(b);assert.notEqual(now,last);assert.deepEqual({...now},reference(c,b));last=now;}
+ c.simulationRuntimeCache={playerBuffCoefficients:new WeakMap()};assert.notEqual(c.playerBuffCoefficients(b),last);
+ c.simulationRuntimeCache=null;assert.deepEqual({...c.playerBuffCoefficients(b)},reference(c,b));
+});
+test('T3 target/turn/buddy magic/attribute gates remain dynamic across cache hits',()=>{
+ const c=context(),s=state();c.getPlayerMagicRuntimeMeta=()=>({runtimeAtk:100,buddyAtk:0,magicAttribute:'火',adjustedPower:'',level:10,magicRatio:1,attributeAdjust:1,rengekiMultiplier:1});
+ c.playerAttributeMultiplier=()=>1;c.sumDamageDownRatesForCard=()=>0;c.effectProbability=x=>x;
+ const b={buffOption:'属性ダメUP',powerOption:'小',levelOption:10,attributeOption:'火',magicOption:'M1',isBuddyGenerated:true};
+ const e={targetDeckIndex:0,turns:1,buff:b};s.playerBuffs=[e];const damage=()=>c.calculatePlayerDamageBaseFromState(s,'0-M1',0,1,'火',0,false).damage;
+ assert.equal(damage(),105);b.attributeOption='水';assert.equal(damage(),100);b.attributeOption='火';b.magicOption='M2';assert.equal(damage(),100);b.magicOption='M1';e.turns=0;assert.equal(damage(),100);e.turns=1;e.targetDeckIndex=1;assert.equal(damage(),100);e.targetDeckIndex=0;assert.equal(damage(),105);
+});

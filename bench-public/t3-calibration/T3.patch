+// Buff descriptors repeat across prepared trials; dynamic target/turn/attribute
+// checks remain at the call site. Guard raw fields so edited descriptors cannot
+// reuse stale coefficients. The map lives only for one prepared runtime.
+function playerBuffCoefficients(buff: ParsedBuff): PlayerBuffCoefficients {
+  const kind = buff.buffOption, power = buff.powerOption, rawLevel = buff.levelOption;
+  const cache = simulationRuntimeCache?.playerBuffCoefficients;
+  const previous = cache?.get(buff);
+  if (previous && previous.kind === kind && previous.power === power && previous.rawLevel === rawLevel) return previous;
+  const level = Math.min(10, Math.max(1, Math.floor(safeNumber(rawLevel) || 10)));
+  let atkRate = 0, damageRate = 0, criticalRate = 0;
+  if (kind === 'ATKUP' || kind === 'ATKDOWN') {
+    atkRate = safeNumber(atkbuffDict[`${kind}(${power})${level}`]);
+  } else if (kind === 'ダメージUP' || kind === 'ダメージDOWN' || kind === '属性ダメUP' || kind === '属性ダメDOWN') {
+    const prefix = kind === 'ダメージUP' ? 'ダメUP' : kind === 'ダメージDOWN' ? 'ダメDOWN' : kind;
+    damageRate = safeNumber(dmgbuffDict[`${prefix}(${power})${level}`]);
+  } else if (kind === 'クリティカル') {
+    criticalRate = criticalChanceFromPower(power);
+  }
+  const value = { kind, power, rawLevel, atkRate, damageRate, criticalRate };
+  cache?.set(buff, value);
+  return value;
+}

+/** Exploration-only plug-in estimate of the best ordinary score in `attempts`.
+ * Proposal weights restore ordinary upper-tail probability; their sum is NOT
+ * the denominator. Clipping the empirical tail and the nonlinear transform
+ * introduce finite-sample bias. Ordinary validation remains authoritative.
+ */
+export function importanceExpectedBestScore(
+  observations: readonly WeightedObservation[], attempts: number,
+): number {
+  const n = observations.length;
+  if (!n || !Number.isInteger(attempts) || attempts < 1
+    || observations.some(({score, weight}) => !Number.isFinite(score)
+      || !Number.isFinite(weight) || weight < 0)) return 0;
+  const positive = observations.filter(({score}) => score > 0).sort((a,b) => b.score-a.score);
+  let cumulativeWeight = 0, value = 0;
+  for (let index = 0; index < positive.length;) {
+    const score = positive[index].score;
+    while (index < positive.length && positive[index].score === score)
+      cumulativeWeight += positive[index++].weight;
+    const tail = Math.max(0, Math.min(1, cumulativeWeight / n));
+    const reach = tail === 1 ? 1 : -Math.expm1(attempts * Math.log1p(-tail));
+    value += (score - (positive[index]?.score ?? 0)) * reach;
+  }
+  return value;
+}

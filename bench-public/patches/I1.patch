+ for(let mask=0;mask<256;mask++){const scores=Array.from({length:8},(_,i)=>mask&(1<<i)?[0,50,100,100][i%4]:0);for(const m of [1,30])close(estimate(scores.map(score=>({score,weight:1})),m),ordinary(scores,m));}
+});

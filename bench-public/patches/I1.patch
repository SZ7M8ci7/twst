+const {importanceExpectedBestScore:estimate}=moduleValue.exports;
+const close=(a,b)=>assert.ok(Math.abs(a-b)<1e-8*Math.max(1,Math.abs(b)),`${a} != ${b}`);
+function ordinary(scores,m){const sorted=[...scores].map(s=>Math.max(0,s)).sort((a,b)=>a-b),n=sorted.length;return sorted.reduce((v,s,i)=>v+s*(((i+1)/n)**m-(i/n)**m),0);}

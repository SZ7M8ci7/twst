+ const a=[{score:100,weight:.4},{score:50,weight:.8},{score:0,weight:5},{score:100,weight:.2}];const saved=JSON.stringify(a);
+ close(estimate(a,1),(100*.6+50*.8)/4);close(estimate(a,30),50*(1-(1-.6/4)**30)+50*(1-(1-1.4/4)**30));assert.equal(JSON.stringify(a),saved);
+});
+test('I1 distinguishes rare true probabilities without a threshold discontinuity',()=>{
+ const value=p=>estimate([{score:60000,weight:2*p},{score:0,weight:2*(1-p)}],30);
+ for(const p of [.0016,.0004])close(value(p),60000*(1-(1-p)**30));assert.ok(value(.0016)>value(.0004));
+});
+test('I1 handles empty, zero, invalid and clipped overweight tails',()=>{
+ assert.equal(estimate([],30),0);assert.equal(estimate([{score:0,weight:1},{score:-10,weight:1}],30),0);
+ for(const m of [0,-1,1.5,NaN,Infinity])assert.equal(estimate([{score:10,weight:1}],m),0);
+ for(const r of [{score:NaN,weight:1},{score:10,weight:-1},{score:10,weight:Infinity}])assert.equal(estimate([r],30),0);
+ close(estimate([{score:100,weight:4},{score:50,weight:1}],30),100);

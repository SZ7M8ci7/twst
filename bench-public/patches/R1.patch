+/** Unbiased U-statistic for expected maximum when n >= attempts.
+ * Development screening only: validation/display keep empirical estimates.
+ * For smaller samples the empirical fallback avoids changing the objective's
+ * attempt count or claiming extrapolation beyond observed data.
+ */
+export function developmentExpectedBestScore(samples: Samples, attempts: number): number {
+  const n = samples.scores.length;
+  if (!Number.isInteger(attempts) || attempts < 1 || n < attempts) return expectedBestScore(samples, attempts);
+  const positive = sortedPositiveScores(samples);
+  let noLarger = 1, expected = 0;
+  for (let j = 0; j < positive.length && noLarger > 0; j++) {
+    const next = noLarger * Math.max(0, n - j - attempts) / (n - j);
+    expected += positive[j] * (noLarger - next);
+    noLarger = next;
+  }
+  return expected;
 }
 

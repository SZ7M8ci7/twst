+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs'),path=require('node:path'),vm=require('node:vm'),ts=require('typescript');
+test('V2 actual island wrapper routes start/resume tail but excludes manual evaluate',async()=>{
+  const calls=[],messages=[];
+  class Session{
+    constructor(input){this.input=input;}
+    async run(_d,p,continuous){calls.push(['run',continuous]);p({phase:'done'});}
+    async runValidationTail(_d,p){calls.push(['tail']);p({phase:'done'});}
+    refineValidation(id){calls.push(['refine',id]);}
+    checkpoint(){return {finalists:[]};} stop(){}
+  }
+  const module={exports:{}};
+  const deps={
+    '@/assets/chara.json':[], '@/workers/resourceBattleHost':{createResourceBattleHost:()=>({})},
+    '@/domain/examSearch/scheduler':{SearchSession:Session}, '@/domain/examSearch/variants':{validateInput:()=>null},
+    '@/domain/examSearch/statistics':{displayProgress:p=>p},
+    './examSearchRun':{runSessionWithinBudget:async(r,_d,p,o)=>{await r.run(100,p);if(o.allowRepeat){assert.equal(typeof r.runValidationTail,'function');await r.runValidationTail(10,p);}else assert.equal(r.runValidationTail,undefined);}},
+  };
+  const source=fs.readFileSync(path.join(__dirname,'../src/workers/examSearchIslandRuntime.ts'),'utf8');
+  const code=ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2021,esModuleInterop:true}}).outputText;
+  vm.runInNewContext(code,{module,exports:module.exports,require:id=>{assert.ok(id in deps,`unexpected dependency ${id}`);return deps[id];},Date,Error});
+  const runtime=module.exports.createIslandRuntime(m=>messages.push(m)),input={attempts:30,desiredProbability:.8};
+  await runtime.handle({method:'start',id:1,island:0,islandCount:1,input,nonce:'v2',durationMs:100});
+  await runtime.handle({method:'resume',id:2,island:0,durationMs:100,continuous:true});
+  await runtime.handle({method:'evaluate',id:3,island:0,durationMs:100,candidateId:'selected',continuous:true});
+  assert.ok(messages.every(m=>!m.error));
+  assert.deepEqual(calls,[['run',false],['tail'],['run',true],['tail'],['refine','selected'],['run',false]]);
+});

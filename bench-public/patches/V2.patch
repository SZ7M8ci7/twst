+
+function v2Rows() {
+  const input=fixture(),candidate=generation.generateCandidates(input,generation.buildTasks(input,catalog)[0],catalog)[0];
+  const make=(id,n=2048)=>({candidate:{...clone(candidate),id},development:{scores:[10],retired:0,turns:1},
+    validation:{scores:Array(n).fill(10),retired:0,turns:n},validationTarget:n,validationBest:{seed:`old-${id}`,score:10}});
+  return {input,rows:[make('v2-a'),make('v2-b')],make};
+}
+test('V2 tail commits a full ordinary cohort atomically without generating candidates',async()=>{
+  const {input,rows}=v2Rows(),seeds=[],published=[];
+  const engine={prepare:async()=>{},trial:seed=>{seeds.push(seed);return {score:20,retired:false,finishTurn:2};}};
+  const session=new SearchSession(input,catalog,engine,'v2');session.finalists=rows;
+  await session.runValidationTail(1000,p=>{published.push(clone(p));if(p.phase==='validate')session.stop();});
+  assert.equal(seeds.length,128);assert.equal(new Set(seeds).size,128);
+  assert.ok(seeds.every(s=>s.startsWith('v2:validation:tail:')));
+  for(const row of rows){assert.equal(row.validation.scores.length,2112);assert.equal(row.validationTarget,2112);assert.equal(row.validationBest.score,20);assert.equal(row.validation.turns,2176);}
+  assert.ok(published.every(p=>p.results.every(r=>r.validation.scores.length>=r.validationTarget)));
+  const cp=session.checkpoint();assert.equal(cp.evaluatedCount,0);assert.equal(cp.generatedCount,0);assert.equal(cp.pool.length,0);
+  assert.deepEqual(clone(cp.tailValidation),{attempted:128,committed:128,discarded:0,cohortRounds:1});
+  assert.equal(published.at(-1).phase,'stopped');assert.equal(published.at(-1).elapsedMs,cp.elapsed);
+});
+test('V2 stop discards every partial-cohort score and best but consumes seeds across restore',async()=>{
+  const {input,rows}=v2Rows(),seeds=[];let session;
+  const engine={prepare:async()=>{},trial:seed=>{seeds.push(seed);if(seeds.length===70)session.stop();return {score:999,retired:true,finishTurn:3};}};
+  session=new SearchSession(input,catalog,engine,'v2-stop');session.finalists=rows;
+  const before=clone(rows);await session.runValidationTail(1000,()=>{});
+  assert.deepEqual(clone(rows),before);assert.equal(session.checkpoint().trialSerial,70);
+  assert.deepEqual(clone(session.checkpoint().tailValidation),{attempted:70,committed:0,discarded:70,cohortRounds:0});
+  const storage=load('src/storage/examSearchStorage.ts'),{ENGINE_VERSION}=load('src/domain/examSearch/types.ts');
+  const saved={input,checkpoint:clone(session.checkpoint()),version:ENGINE_VERSION,catalogVersion:'V2-test'};
+  assert.equal(await storage.saveSearchSession(saved,storage.serializeSearchSession(saved)),true);
+  const loaded=storage.loadSearchSession();assert.deepEqual(clone(loaded.checkpoint),saved.checkpoint);
+  const restored=new SearchSession(input,catalog,{prepare:async()=>{},trial:seed=>{seeds.push(seed);return {score:20,retired:false,finishTurn:1};}},'ignored',loaded.checkpoint);
+  await restored.runValidationTail(1000,p=>{if(p.phase==='validate')restored.stop();});
+  assert.equal(new Set(seeds).size,seeds.length);assert.equal(restored.checkpoint().trialSerial,198);
+  assert.equal(restored.checkpoint().tailValidation.discarded,70);
+  assert.ok(restored.checkpoint().elapsed>=session.checkpoint().elapsed);
+  assert.ok(restored.checkpoint().finalists.every(r=>r.validation.scores.length===2112&&r.validationBest.score===20));
+});
+test('V2 deadline discards staged work and does not leak its best replay',async()=>{
+  const {input,rows}=v2Rows();let prepares=0;
+  const session=new SearchSession(input,catalog,{prepare:async()=>{if(++prepares===2)await new Promise(r=>setTimeout(r,150));},trial:()=>({score:999,retired:false,finishTurn:2})},'v2-deadline');session.finalists=rows;
+  const before=clone(rows);await session.runValidationTail(100,()=>{});
+  assert.deepEqual(clone(rows),before);
+  const cp=session.checkpoint();assert.equal(cp.tailValidation.committed,0);assert.ok(cp.tailValidation.discarded>0);assert.ok(cp.elapsed>=100);
+});
+test('V2 refuses incomplete finalists and preserves capped or manually enlarged targets',async()=>{
+  const {input,rows,make}=v2Rows();let trials=0;
+  const engine={prepare:async()=>{},trial:()=>{trials++;return {score:1,retired:false,finishTurn:1};}};
+  const incomplete=new SearchSession(input,catalog,engine,'v2-incomplete');rows[1].validationTarget++;incomplete.finalists=rows;
+  await incomplete.runValidationTail(10,()=>{});assert.equal(trials,0);
+  const session=new SearchSession(input,catalog,engine,'v2-cap');session.finalists=[make('small',32704),make('large',131072)];const large=clone(session.finalists[1]);
+  await session.runValidationTail(1000,()=>{});
+  assert.equal(trials,64);assert.equal(session.finalists[0].validationTarget,32768);assert.equal(session.finalists[0].validation.scores.length,32768);
+  assert.deepEqual(clone(session.finalists[1]),large);assert.equal(session.checkpoint().tailValidation.cohortRounds,1);
+});
+test('V2 budget helper uses only sub-pass search tail and publishes one terminal',async()=>{
+  for(const mode of ['tail','evaluate','stopped','large']){
+    let now=0,tailCalls=0;const phases=[];
+    const runner={run:async(_d,p)=>{now+=mode==='large'?1000:6000;p(runProgress(mode==='stopped'?'stopped':'done'));},
+      runValidationTail:async(d,p)=>{tailCalls++;assert.equal(d,14000);p(runProgress('validate'));now+=d;p({...runProgress('done'),elapsedMs:now});}};
+    await runSessionWithinBudget(runner,20000,p=>phases.push(p.phase),{now:()=>now,allowRepeat:mode!=='evaluate'});
+    assert.equal(tailCalls,mode==='tail'?1:0);assert.equal(phases.filter(p=>p==='done'||p==='stopped').length,1);
+  }
+});
+test('V2 short tail after continuation callback does not expose intermediate done',async()=>{
+  let now=0,calls=0,tailCalls=0;const phases=[];
+  const runner={run:async(_d,p)=>{calls++;now+=1000;p(runProgress('done'));},runValidationTail:async(d,p)=>{tailCalls++;assert.equal(d,10000);p(runProgress('done'));}};
+  await runSessionWithinBudget(runner,50000,p=>{phases.push(p.phase);if(p.phase==='generate')now=40000;},{now:()=>now,allowRepeat:true});
+  assert.equal(calls,1);assert.equal(tailCalls,1);assert.deepEqual(phases,['generate','done']);
+});
+
+
+test('V2 heartbeat permits stop without exposing partial samples or targets',async()=>{
+  const {input,rows}=v2Rows();let heartbeat=false;
+  const session=new SearchSession(input,catalog,{prepare:async()=>{await new Promise(r=>setTimeout(r,160));},trial:()=>({score:999,retired:false,finishTurn:2})},'v2-heartbeat');
+  session.finalists=rows;const before=clone(rows);
+  await session.runValidationTail(1000,p=>{if(p.phase==='validate'){heartbeat=true;assert.deepEqual(clone(p.results),before);session.stop();}});
+  assert.ok(heartbeat);assert.deepEqual(clone(rows),before);assert.equal(session.checkpoint().tailValidation.committed,0);
+  assert.equal(session.checkpoint().tailValidation.discarded,16);
+});
+
+test('V2 trial exceptions discard the whole pending cohort and retain elapsed diagnostics',async()=>{
+  const {input,rows}=v2Rows();let calls=0;
+  const session=new SearchSession(input,catalog,{prepare:async()=>{},trial:()=>{if(++calls===70)throw Error('engine failed');return {score:999,retired:false,finishTurn:1};}},'v2-error');
+  session.finalists=rows;const before=clone(rows);
+  await assert.rejects(session.runValidationTail(1000,()=>{}),/engine failed/);
+  const cp=session.checkpoint();assert.deepEqual(clone(rows),before);assert.equal(cp.trialSerial,70);
+  assert.deepEqual(clone(cp.tailValidation),{attempted:70,committed:0,discarded:70,cohortRounds:0});assert.ok(cp.elapsed>0);
+});
+test('V2 compressed storage preserves counters and old checkpoints default to zero tail work',async()=>{
+  const {input,make}=v2Rows(),storage=load('src/storage/examSearchStorage.ts'),{ENGINE_VERSION}=load('src/domain/examSearch/types.ts');
+  const session=new SearchSession(input,catalog,{},'v2-storage');session.finalists=[make('large',131072)];session.trialSerial=981;
+  session.tailValidation={attempted:192,committed:128,discarded:64,cohortRounds:1};
+  const value={input,checkpoint:clone(session.checkpoint()),version:ENGINE_VERSION,catalogVersion:'v2'};
+  const raw=storage.serializeSearchSession(value);assert.equal(JSON.parse(raw).checkpointEncoding,'lz-utf16-v1');
+  assert.equal(await storage.saveSearchSession(value,raw),true);
+  const loaded=storage.loadSearchSession();assert.deepEqual(clone(loaded.checkpoint),value.checkpoint);
+  const restored=new SearchSession(input,catalog,{},'ignored',loaded.checkpoint);assert.equal(restored.checkpoint().trialSerial,981);assert.deepEqual(clone(restored.checkpoint().tailValidation),value.checkpoint.tailValidation);
+  delete loaded.checkpoint.tailValidation;
+  const legacy=new SearchSession(input,catalog,{},'ignored',loaded.checkpoint);assert.deepEqual(clone(legacy.checkpoint().tailValidation),{attempted:0,committed:0,discarded:0,cohortRounds:0});
+});

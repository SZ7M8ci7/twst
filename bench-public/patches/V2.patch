@@ -310,6 +314,63 @@ export class SearchSession {
     this.finalists=[...retained,...selected.slice(0,MAX_FINALISTS-retained.length).map(r=>({...r,validation:emptySamples(),validationBest:undefined,validationTarget:VALIDATION_SAMPLES}))];
     this.round++;
   }
+  /** Spend only otherwise unused sub-pass time; never expose a partial cohort. */
+  async runValidationTail(durationMs: number, publish: (progress: SearchProgress) => void) {
+    const start = performance.now(), deadline = start + Math.max(0, durationMs);
+    const report = (phase: SearchProgress['phase']) => publish({ phase, generated: this.generatedCount,
+      evaluated: this.evaluatedCount, tasksDone: this.cursor, tasksTotal: this.knownTasksTotal,
+      elapsedMs: this.elapsed + performance.now() - start, results: this.finalists });
+    let uncommitted = 0, lastReport = start;
+    try {
+      if (this.finalists.length && this.finalists.every(r => r.validation.scores.length >= r.validationTarget)) {
+        while (!this.stopped && performance.now() < deadline) {
+          const eligible = this.finalists.filter(r => r.validation.scores.length + 64 <= CONTINUOUS_VALIDATION_SAMPLES);
+          if (!eligible.length) break;
+          const staged: { result: SearchResult; samples: Samples; best: SearchResult['validationBest'] }[] = [];
+          for (const result of eligible) {
+            if (this.stopped || performance.now() >= deadline) break;
+            await this.engine.prepare(this.input, result.candidate);
+            const samples = emptySamples();
+            let best = result.validationBest;
+            for (let i = 0; i < 64 && !this.stopped && performance.now() < deadline; i++) {
+              // Consume serials even for discarded cohorts, so stop/restore never
+              // retries an already attempted seed. Normal validation is unchanged.
+              const seed = `${this.nonce}:validation:tail:${this.trialSerial++}:${result.candidate.id}`;
+              this.tailValidation.attempted++; uncommitted++;
+              const trial = this.engine.trial(seed, result.candidate.policy);
+              samples.scores.push(trial.score); samples.retired += Number(trial.retired); samples.turns += trial.finishTurn;
+              if (!best || trial.score > best.score) best = { seed, score: trial.score };
+              if ((i + 1) % 16 === 0) {
+                await yieldEventLoop();
+                if (performance.now() - lastReport >= 150) {
+                  report('validate'); lastReport = performance.now();
+                }
+              }
+            }
+            if (samples.scores.length !== 64) break;
+            staged.push({ result, samples, best });
+          }
+          if (this.stopped || performance.now() >= deadline || staged.length !== eligible.length) break;
+          // One synchronous transaction: every published finalist remains complete.
+          for (const { result, samples, best } of staged) {
+            result.validation.scores.push(...samples.scores);
+            result.validation.retired += samples.retired; result.validation.turns += samples.turns;
+            result.validationBest = best; result.validationTarget = result.validation.scores.length;
+          }
+          this.tailValidation.committed += uncommitted; this.tailValidation.cohortRounds++; uncommitted = 0;
+          report('validate');
+        }
+      }
+    } finally {
+      this.tailValidation.discarded += uncommitted;
+      // Account for unsuccessful cohorts too, including exception/cancellation work.
+      const spent = performance.now() - start;
+      this.elapsed += spent;
+    }
+    publish({ phase: this.stopped ? 'stopped' : 'done', generated: this.generatedCount,
+      evaluated: this.evaluatedCount, tasksDone: this.cursor, tasksTotal: this.knownTasksTotal,
+      elapsedMs: this.elapsed, results: this.finalists });
+  }
   async run(durationMs: number, publish: (progress: SearchProgress) => void, continuous = false) {
     this.stopped = false;
     this.continuous = continuous;

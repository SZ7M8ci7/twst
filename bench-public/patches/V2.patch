@@ -35,15 +36,28 @@ export async function runSessionWithinBudget(
   let pendingTerminal: SearchProgress | undefined;
   let previousTerminal: { generated: number; evaluated: number } | undefined;
 
+  const finish = async (terminal: SearchProgress) => {
+    const remaining = Math.max(0, deadline - now());
+    let final = terminal;
+    if (allowRepeat && terminal.phase === 'done' && !shouldStop() && remaining > 0
+      && remaining < minimumRemainingMs && session.runValidationTail) {
+      await session.runValidationTail(remaining, progress => {
+        if (progress.phase === 'done' || progress.phase === 'stopped') final = progress;
+        else publish(progress);
+      });
+    }
+    publish(final);
+  };
+
   while (passes < maxPasses) {
     const remaining = Math.max(0, deadline - now());
     if (!remaining || shouldStop()) {
-      if (pendingTerminal) publish(pendingTerminal);
+      if (pendingTerminal) await finish(pendingTerminal);
       break;
     }

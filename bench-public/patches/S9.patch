+import type { SearchResult } from '@/domain/examSearch/types';
+
+// Isolated research switches. Production defaults remain unchanged until a
+// paired, independent benchmark justifies adopting an individual hypothesis.
+export const samplingExperiments = {
+  balancedContenders: false,
+  ordinaryDiscoveryFirst: false,
+  expectedPlanParents: false,
+  shortContenderBatches: false,
+  ordinaryLoadoutFirst: false,
+  ordinaryPlanFirst: false,
+  lighterDiscoveryImportance: true,
+};
+
+export function balancedContenderOrder(rows: SearchResult[], batch: number): SearchResult[] {
+  const costs = [...new Set(rows.map(row => row.candidate.cost))].sort((a,b) => a-b);
+  if (!costs.length) return [];
+  const offset = batch % costs.length;
+  const groups = [...costs.slice(offset), ...costs.slice(0,offset)]
+    .map(cost => rows.filter(row => row.candidate.cost === cost));
+  return Array.from({length: Math.max(...groups.map(group => group.length))}, (_,i) =>
+    groups.flatMap(group => group[i] ? [group[i]] : [])).flat();
+}
+
+export function expectedPlanParentOrder(rows: SearchResult[], pool: SearchResult[], quality: (row: SearchResult) => number): SearchResult[] {
+  const costs = [...new Set(rows.map(row => row.candidate.cost))].sort((a,b) => a-b);
+  const groups = costs.map(cost => {
+    const available = pool.filter(row => row.candidate.cost === cost);
+    const champion = available.reduce<SearchResult | undefined>((best,row) => !best || quality(row)>quality(best) ? row : best, undefined);
+    return [...new Map([...(champion ? [champion] : []), ...rows.filter(row => row.candidate.cost === cost)]
+      .map(row => [row.candidate.id,row])).values()];
+  });
+  return Array.from({length: Math.max(0,...groups.map(group => group.length))}, (_,i) =>
+    groups.flatMap(group => group[i] ? [group[i]] : [])).flat();
+}

--- /dev/null
+++ b/src/domain/examSearch/uncertaintyAllocation.ts
@@ -0,0 +1,54 @@
+import type { SearchResult } from '@/domain/examSearch/types';
+import { interval, reachProbability } from '@/domain/examSearch/statistics';
+
+/** A repeated-look exploration heuristic, NOT a confidence interval, score
+ * bound or pruning certificate. A one-standard-error Wilson-shaped width is
+ * mapped to the chance of at least one positive score in the requested number
+ * of attempts. It ignores winning-score magnitude; ordinary Emax champions
+ * and independent validation remain responsible for the actual objective.
+ * Only ordinary observations count: importance samples use another law.
+ */
+export function successUncertaintyPriority(scores: readonly number[], attempts: number): number {
+  if (!Number.isInteger(attempts) || attempts < 1) return 0;
+  const positive = scores.reduce((count, score) => count + Number(Number.isFinite(score) && score > 0), 0);
+  const [lower, upper] = interval(positive, scores.length, 1);
+  return Math.max(0, reachProbability(upper, attempts) - reachProbability(lower, attempts));
+}
+
+function tieHash(value: string): number {
+  let hash = 2166136261;
+  for (let i = 0; i < value.length; i++) hash = Math.imul(hash ^ value.charCodeAt(i), 16777619);
+  return hash >>> 0;
+}
+
+/** Replace at most the last contender in each cost band, without adding slots.
+ * Bands with fewer than four slots stay intact. For four slots the existing
+ * first three/champions stay intact.
+ * Recompute after every ordinary batch; no mutable cache/checkpoint state.
+ */
+export function uncertaintyContenders(
+  pool: readonly SearchResult[], baseline: readonly SearchResult[], attempts: number, nonce: string,
+): SearchResult[] {
+  const allocated: SearchResult[] = [];
+  for (const cost of [...new Set(baseline.map(result => result.candidate.cost))]) {
+    const band = baseline.filter(result => result.candidate.cost === cost);
+    if (band.length < 4 || band[band.length - 1].development.scores.some(score => Number.isFinite(score) && score > 0)) {
+      // Never evict an existing fourth contender with ordinary positive evidence.
+      allocated.push(...band); continue;
+    }
+    const protectedRows = band.slice(0, -1), protectedSet = new Set(protectedRows);
+    let chosen: SearchResult | undefined, best = -1, bestN = Infinity, bestTie = Infinity;
+    for (const result of pool) {
+      if (result.candidate.cost !== cost || protectedSet.has(result)) continue;
+      const scores = result.development.scores, n = scores.length;
+      if (n >= 512) continue;
+      const priority = successUncertaintyPriority(scores, attempts);
+      const tie = tieHash(`${nonce}:${result.candidate.id}`);
+      if (priority > best || (priority === best && (n < bestN || (n === bestN && tie < bestTie)))) {
+        chosen = result; best = priority; bestN = n; bestTie = tie;
+      }
+    }
+    allocated.push(...protectedRows, chosen ?? band[band.length - 1]);
+  }
+  return allocated;
+}

+import type { SearchResult } from '@/domain/examSearch/types';
+
+export interface ContenderSlot { result: SearchResult; ordinaryOnly: boolean }
+function hasPositive(result: SearchResult): boolean {
+  return result.development.scores.some(score => Number.isFinite(score) && score > 0);
+}
+function stableHash(value: string): number {
+  let hash = 2166136261;
+  for (let i=0;i<value.length;i++) hash = Math.imul(hash ^ value.charCodeAt(i), 16777619);
+  return hash >>> 0;
+}
+
+/** Reserve at most one existing slot per cost for unresolved pool coverage.
+ * No extra slots, proxy fitness, audit scores or importance pseudo-counts.
+ * Recompute once per batch so ordinary observations rotate the queue.
+ */
+export function coverageContenderSlots(contenders: SearchResult[], pool: SearchResult[]): ContenderSlot[] {
+  const costs = [...new Set(contenders.map(result => result.candidate.cost))];
+  const slots = new Map<SearchResult, ContenderSlot>();
+  for (const cost of costs) {
+    const band = contenders.filter(result => result.candidate.cost === cost);
+    for (const result of band) slots.set(result, {result, ordinaryOnly:false});
+    // Keep the first three established roles and every observed ordinary winner.
+    if (band.length < 4 || hasPositive(band[band.length-1])) continue;
+    const replaced = band[band.length-1];
+    const protectedIds = new Set(band.slice(0,-1).map(result => result.candidate.id));
+    const available = pool.filter(result => result.candidate.cost === cost
+      && !protectedIds.has(result.candidate.id) && !hasPositive(result)
+      && result.development.scores.length < 512);
+    available.sort((a,b) => a.development.scores.length-b.development.scores.length
+      || stableHash(a.candidate.id)-stableHash(b.candidate.id)
+      || (a.candidate.id < b.candidate.id ? -1 : a.candidate.id > b.candidate.id ? 1 : 0));
+    if (available.length) slots.set(replaced, {result:available[0], ordinaryOnly:true});
+  }
+  return contenders.map(result => slots.get(result)!);
+}

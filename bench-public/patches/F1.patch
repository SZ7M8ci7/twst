+  assert.ok(!h.calls.scout.includes('fresh'));assert.ok(!h.calls.importance.includes('fresh'));
+  for(const row of [...base,fresh])assert.ok(row.development.scores.length<=512);
+});
+test('F1 scheduler never scans coverage pool after initial stop or expired deadline',async()=>{

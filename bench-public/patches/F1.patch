+
+const {coverageContenderSlots}=load('src/domain/examSearch/coverage.ts');
+function coverageRow(id,n=32,cost=4,positive=false) {
+  return {candidate:{id,cost},development:{scores:Array(n).fill(positive?100:0),retired:n,turns:n,fitnessSum:999999},
+    importance:{n:9999,observations:[]},validation:{scores:[],retired:0,turns:0}};
+}
+test('F1 keeps first three contenders and covers an unresolved candidate outside contenders',()=>{
+  const base=['a','b','c','d'].map(id=>coverageRow(id,128));
+  const fresh=coverageRow('fresh',16),otherCost=coverageRow('otherCost',0,0),winner=coverageRow('winner',1,4,true);
+  const pool=[...base,fresh,otherCost,winner];
+  const before=JSON.stringify(pool),slots=coverageContenderSlots(base,pool);
+  assert.equal(slots.length,base.length);
+  for(let i=0;i<3;i++){assert.equal(slots[i].result,base[i]);assert.equal(slots[i].ordinaryOnly,false);}
+  assert.equal(slots[3].result,fresh);assert.equal(slots[3].ordinaryOnly,true);
+  assert.equal(JSON.stringify(pool),before);
+});
+test('F1 preserves every positive original contender and does not add slots to small bands',()=>{
+  const base=['a','b','c','d'].map(id=>coverageRow(id,32,4,true));
+  const fresh=coverageRow('fresh',0);
+  for(const band of [base,base.slice(0,3),[]]) {
+    const slots=coverageContenderSlots(band,[...band,fresh]);
+    assert.equal(slots.length,band.length);
+    slots.forEach((slot,i)=>{assert.equal(slot.result,band[i]);assert.equal(slot.ordinaryOnly,false);});
+  }
+});
+test('F1 recomputes ordinary counts every batch and ignores fitness or importance counts',()=>{
+  const base=['a','b','c','d'].map(id=>coverageRow(id,128));
+  const x=coverageRow('x',0),y=coverageRow('y',16);
+  x.development.fitnessSum=-9999;x.importance.n=1e9;
+  y.development.fitnessSum=1e20;
+  const pool=[...base,x,y];
+  assert.equal(coverageContenderSlots(base,pool)[3].result,x);
+  x.development.scores.push(...Array(32).fill(0));
+  assert.equal(coverageContenderSlots(base,pool)[3].result,y);
+  y.development.scores.push(1);
+  assert.equal(coverageContenderSlots(base,pool)[3].result,x);
+});
+test('F1 strata preserve total slots, use deterministic tie order and reject capped candidates',()=>{
+  const base=[0,1,4].flatMap(cost=>['a','b','c','d'].map(id=>coverageRow(`${cost}${id}`,128,cost)));
+  const extra=[0,1,4].flatMap(cost=>['x','y'].map(id=>coverageRow(`${cost}${id}`,0,cost)));
+  const capped=coverageRow('capped',512,4);
+  const first=coverageContenderSlots(base,[...base,...extra,capped]);
+  const reverse=coverageContenderSlots(base,[...extra,...base,capped].reverse());
+  assert.equal(first.length,12);
+  first.forEach((slot,i)=>{
+    assert.equal(slot.result.candidate.cost,base[i].candidate.cost);
+    assert.equal(slot.result,reverse[i].result);
+    assert.equal(slot.ordinaryOnly,i%4===3);
+    assert.notEqual(slot.result,capped);
+  });
+  assert.equal(new Set(first.map(slot=>slot.result.candidate.id)).size,12);
+});
+test('F1 falls back unchanged when no eligible unresolved candidate remains',()=>{
+  const base=['a','b','c','d'].map(id=>coverageRow(id,512));
+  const slots=coverageContenderSlots(base,base);
+  slots.forEach((slot,i)=>{assert.equal(slot.result,base[i]);assert.equal(slot.ordinaryOnly,false);});
+});
+
+function coverageSchedulerHarness() {
+  let now=0,scans=0;
+  const module={exports:{}};
+  const code=ts.transpileModule(fs.readFileSync(path.join(root,'src/domain/examSearch/scheduler.ts'),'utf8'),
+    {compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2021}}).outputText;
+  const requireForTest=id=>id==='@/domain/examSearch/coverage'
+    ?{coverageContenderSlots:(...args)=>{scans++;return coverageContenderSlots(...args);}}
+    :id.startsWith('@/')?load(`src/${id.slice(2)}.ts`):require(id);
+  vm.runInNewContext(code,{module,exports:module.exports,require:requireForTest,
+    performance:{now:()=>now},setTimeout,setImmediate,MessageChannel},{filename:'scheduler-F1-integration.ts'});
+  const input=fixture();input.preset={...input.preset,kind:'ATTACK'};
+  let current,session;const calls={ordinary:[],importance:[],scout:[]};
+  const engine={prepare:async(_,candidate)=>{current=candidate;},trial:()=>{
+    calls.ordinary.push(current.id);return {score:0,retired:true,finishTurn:1};}};
+  session=new module.exports.SearchSession(input,catalog,engine,'F1-integration');
+  session.partition={islandIndex:1,islandCount:2};
+  session.tasksReady=true;session.tasks=[];session.pool=[];session.pending=[];session.finalists=[];
+  session.diverseParents=()=>[];session.selectFinalists=()=>{};
+  session.scout=async result=>calls.scout.push(result.candidate.id);
+  session.importanceScreen=async result=>calls.importance.push(result.candidate.id);
+  return {session,calls,clock:value=>{now=value;},scans:()=>scans};
+}
+test('F1 scheduler suppresses IS/scout only for coverage and enforces 512 ordinary cap',async()=>{
+  const h=coverageSchedulerHarness();

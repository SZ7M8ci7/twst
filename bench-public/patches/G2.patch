+
+test('DF curse construction reserves a discarded cure spell pair for real trials',()=>{
+  const input=fixture(); input.budget=0; input.preset.kind='DEFENCE';
+  input.preset.specialChallenges=[{id:'curse-reserve',effects:[{kind:'playerCurse',duration:3}]}];
+  for(const card of [...input.roster,...input.supports]){card.totsu=4;card.level=110;}
+  const data=clone(catalog),name=input.roster[0].name;
+  for(const card of [...input.roster,...input.supports]){
+    const raw=data[card.name]; raw.etc='';
+    for(const m of [1,2,3]){raw[`magic${m}etc`]='';raw[`magic${m}heal`]='';raw[`magic${m}buf`]='';}
+  }
+  data[name].etc='呪い無効(自/3T)(M3)';
+  const task={anchor:name,totsu:4,cost:0,challenges:['curse-reserve'],style:0};
+  const result=generation.generateCandidates(input,task,data);
+  assert.ok(result.length>0);
+  assert.ok(result.some(candidate=>candidate.cards.some(card=>card.name===name&&card.selectedMagic.includes(3))));
+  for(const candidate of result)assert.ok(variants.candidateSatisfiesConstraints(input,candidate,data));
+});

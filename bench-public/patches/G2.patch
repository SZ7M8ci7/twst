+  // A curse-safe spell pair can be weaker under the scalar team estimate
+  // while enabling healing after the opening turns. Reserve one real trial.
+  const cureSetups:typeof finished=[];
+  const curseChallenge=input.preset.specialChallenges?.some(challenge=>task.challenges.includes(challenge.id)
+    &&challenge.effects.some(effect=>effect.kind==='playerCurse'));
+  if(input.preset.kind==='DEFENCE'&&curseChallenge)for(const {cards} of finished)for(const [index,card] of cards.entries()) {
+    const cureMagic=parseMagicBuffsFromEtc(catalog[card.name]).filter(buff=>
+      buff.buffOption==='呪い無効'||buff.buffOption==='デバフ解除').map(buff=>Number(buff.magicOption.slice(1)));
+    if(!cureMagic.length||card.selectedMagic.some(m=>cureMagic.includes(m)))continue;
+    const original=(card.support?input.supports:input.roster).find(raw=>raw.name===card.name)!;
+    for(const option of cardVariants(original,catalog[card.name].rare,card.support,card.totsu,card.additionalLevels)) {
+      if(!option.selectedMagic.some(m=>cureMagic.includes(m)))continue;
+      const team=cards.map((other,i)=>i===index?option:other);
+      cureSetups.push({cards:team,value:estimate(team)});
+    }
+  }
+  const initial=[...finished,...cureSetups.sort((a,b)=>b.value-a.value).slice(0,1),...setups.sort((a,b)=>b.value-a.value).slice(0,2),
     ...scoringSetups.sort((a,b)=>b.gain-a.gain||b.value-a.value).slice(0,2)];

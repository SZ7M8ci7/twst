+import { CONTENDER_ORDINARY_SAMPLES } from '@/domain/examSearch/sampling';
+import type { Samples, SearchResult } from '@/domain/examSearch/types';
+import { expectedBestScore } from '@/domain/examSearch/statistics';
+
+// A fixed ordinary-trial prefix, not a reconstruction of fitnessSum or a claim
+// to summarize all later trials. Policy/time-dependent changes can make this
+// early prefix unrepresentative; it is not evidence of a confident score gain.
+// Bounds checkpoint growth at 128 numbers/row.
+export const DEVELOPMENT_FITNESS_PREFIX_LIMIT = 128;
+export function recordDevelopmentFitness(samples: Samples, fitness: number): void {
+  const prefix = samples.developmentFitnessPrefix ??= [];
+  if (prefix.length < DEVELOPMENT_FITNESS_PREFIX_LIMIT)
+    prefix.push(Number.isFinite(fitness) && fitness > 0 ? fitness : 0);
+}
+const allFail = (row: SearchResult) => row.development.scores.length > 0
+  && row.development.scores.every(score => !(Number.isFinite(score) && score > 0));
+
+/** One extra observation opportunity, never a score-ranking objective.
+ * Near-loss fitness rewards damage/survival and can oppose actual winning
+ * score. Its upper tail is merely a risky exploration proxy, not Emax(score).
+ * Preserve every ordinary-positive candidate, cost-band slot count, and total
+ * observation slots. If no all-fail slot exists, do not expand the budget.
+ */
+export function reserveFitnessTailObserver(selected: SearchResult[], pool: SearchResult[], attempts: number): SearchResult[] {
+  const ids = new Set(selected.map(row => row.candidate.id));
+  const eligibleCosts = new Set(selected.filter(allFail).map(row => row.candidate.cost));
+  let chosen: SearchResult | undefined, best = 0;
+  for (const row of pool) {
+    if (ids.has(row.candidate.id) || !eligibleCosts.has(row.candidate.cost)
+      || row.development.scores.length >= CONTENDER_ORDINARY_SAMPLES || !allFail(row)) continue;
+    const prefix = row.development.developmentFitnessPrefix;
+    if (!prefix?.length) continue; // Legacy checkpoint fitness cannot be inferred.
+    const value = expectedBestScore({scores: prefix, retired: 0, turns: 0}, attempts);
+    if (value > best || value === best && value > 0 && chosen && row.candidate.id < chosen.candidate.id) {
+      chosen = row; best = value;
+    }
+  }
+  if (!chosen) return selected;
+  const result = [...selected];
+  for (let index = result.length - 1; index >= 0; index--) {
+    if (result[index].candidate.cost === chosen.candidate.cost && allFail(result[index])) {
+      result[index] = chosen;
+      break;
+    }
+  }
+  return result;
+}

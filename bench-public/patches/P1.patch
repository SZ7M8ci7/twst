--- a/tests/exam-search.test.cjs
+++ b/tests/exam-search.test.cjs
@@ -2709,3 +2709,71 @@ test('invalid active search settings return translated non-legacy validation cod
     assert.equal(text.examSearch.validation.target,undefined);
   }
 });
+
+const fitnessTail = load('src/domain/examSearch/fitnessTail.ts');
+const proxyRow=(id,cost,fitness,scores=[0,0])=>({candidate:{id,cost,cards:[],challengeIds:[],policy:'effects'},
+  development:{scores:[...scores],fitnessSum:7,retired:0,turns:2,...(fitness?{developmentFitnessPrefix:[...fitness]}:{})},
+  validation:{scores:[],retired:0,turns:0},validationTarget:2048});
+
+test('fitness prefix is bounded and does not rewrite ordinary scores or fitness sum',()=>{
+  const samples={scores:[0,0],fitnessSum:99,retired:1,turns:9};
+  for(let i=0;i<200;i++)fitnessTail.recordDevelopmentFitness(samples,i);
+  assert.equal(samples.developmentFitnessPrefix.length,128);
+  assert.equal(samples.developmentFitnessPrefix[127],127);
+  assert.deepEqual(samples.scores,[0,0]);assert.equal(samples.fitnessSum,99);
+  assert.equal(samples.retired,1);assert.equal(samples.turns,9);
+  const legacy={scores:[0,0],fitnessSum:999999,retired:0,turns:0};
+  fitnessTail.recordDevelopmentFitness(legacy,17);
+  assert.deepEqual(clone(legacy.developmentFitnessPrefix),[17],'old aggregate must never fabricate a prefix');
+});
+
+test('fitness observer preserves positive rows and replaces at most one all-fail slot of the same cost',()=>{
+  const base=[proxyRow('positive',0,[999],[1]),proxyRow('fail0',0,[1]),proxyRow('fail1',1,[1])];
+  const pool=[...base,proxyRow('tail0',0,[500]),proxyRow('tail1',1,[600]),proxyRow('wrong-cost',2,[100000])];
+  const snapshot=clone(pool),out=fitnessTail.reserveFitnessTailObserver(base,pool,30);
+  assert.equal(out.length,base.length);assert.equal(out[0],base[0]);
+  assert.equal(out.filter((r,i)=>r!==base[i]).length,1);assert.equal(out[2].candidate.id,'tail1');
+  assert.deepEqual(clone(out.map(r=>r.candidate.cost)),base.map(r=>r.candidate.cost));
+  assert.deepEqual(clone(pool),snapshot,'no trial or checkpoint data changed');
+  assert.equal(out.reduce((n,r)=>n+r.development.scores.length,0),base.reduce((n,r)=>n+r.development.scores.length,0));
+});
+
+test('fitness observer uses requested attempts but never expands a positive-only observation set',()=>{
+  const base=[proxyRow('old',0,[0])],stable=proxyRow('stable',0,Array(100).fill(100)),rare=proxyRow('rare',0,[200,...Array(99).fill(0)]);
+  assert.equal(fitnessTail.reserveFitnessTailObserver(base,[stable,rare],30)[0].candidate.id,'stable');
+  assert.equal(fitnessTail.reserveFitnessTailObserver(base,[stable,rare],100)[0].candidate.id,'rare');
+  const positive=[proxyRow('winner',0,[1],[1])];
+  assert.equal(fitnessTail.reserveFitnessTailObserver(positive,[rare],100),positive);
+  assert.equal(fitnessTail.reserveFitnessTailObserver(base,[proxyRow('legacy',0,undefined)],30),base);
+  const sample=rare.development,before=stats.searchDevelopmentQuality(sample,{attempts:30,desiredProbability:.05});
+  sample.developmentFitnessPrefix=[99999999];
+  assert.equal(stats.searchDevelopmentQuality(sample,{attempts:30,desiredProbability:.05}),before,'ordinary ranking ignores proxy');
+});
+
+test('fitness prefix survives session checkpoint roundtrip while missing legacy prefixes remain missing',()=>{
+  const input=fixture(),candidate=generation.generateCandidates(input,generation.buildTasks(input,catalog)[0],catalog)[0];
+  assert.ok(candidate);
+  const row=proxyRow('roundtrip',candidate.cost,[10,20,30]);row.candidate=candidate;
+  const session=new SearchSession(input,catalog,{},'fitness-checkpoint');session.pool=[row];
+  const saved=clone(session.checkpoint());
+  const restored=new SearchSession(input,catalog,{},'ignored',saved);
+  assert.deepEqual(clone(restored.checkpoint().pool[0].development.developmentFitnessPrefix),[10,20,30]);
+  delete saved.pool[0].development.developmentFitnessPrefix;
+  const legacy=new SearchSession(input,catalog,{},'ignored',saved);
+  assert.equal(legacy.checkpoint().pool[0].development.developmentFitnessPrefix,undefined);
+});
+
+test('fitness observer skips exhausted ordinary candidates and keeps the old slot when none remain',()=>{
+  const cap=load('src/domain/examSearch/sampling.ts').CONTENDER_ORDINARY_SAMPLES;
+  const selected=[proxyRow('old-slot',0,[1])];
+  const capped=proxyRow('capped',0,[100000],Array(cap).fill(0));
+  const beyond=proxyRow('beyond-cap',0,[200000],Array(cap+1).fill(0));
+  const eligible=proxyRow('eligible',0,[10],Array(cap-1).fill(0));
+  assert.equal(fitnessTail.reserveFitnessTailObserver(selected,[capped,beyond,eligible],30)[0].candidate.id,'eligible',
+    'a high proxy cannot consume a slot when scheduler would skip all ordinary trials');
+  assert.equal(fitnessTail.reserveFitnessTailObserver(selected,[capped,beyond],30),selected,
+    'no eligible candidate means the old observation slot is preserved');
+  const restored=clone([capped,beyond,eligible]);
+  assert.equal(fitnessTail.reserveFitnessTailObserver(selected,restored,30)[0].candidate.id,'eligible',
+    'checkpoint-restored sample counts retain the same eligibility');
+});

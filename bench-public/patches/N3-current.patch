+// Candidate objects remain solely in pending: legacy readers can still drain
+// every generated row even when they do not understand the optional frontier.
+export function roundRobinPending(rows: SearchResult[], groups: readonly string[][]): SearchResult[] {
+  const byId = new Map(rows.map(row => [row.candidate.id, row]));
+  const ordered: SearchResult[] = [];
+  const take = (id: string) => { const row = byId.get(id); if (row) { ordered.push(row); byId.delete(id); } };
+  for (let i = 0; i < Math.max(0, ...groups.map(group => group.length)); i++)
+    for (const group of groups) if (group[i]) take(group[i]);
+  // Restored/filtered rows without metadata must never be discarded.
+  ordered.push(...byId.values());
+  return ordered;
+}

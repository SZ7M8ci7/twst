+test('N3 partial frontier survives actual compressed session storage and island packaging',async()=>{
+  const x=await n3Run({interruptTask:3});
+  x.checkpoint.seen.push('padding'.repeat(30000));
+  const checkpoint=islands.createParallelCheckpoint([x.checkpoint],'n3-fixed');
+  const storage=load('src/storage/examSearchStorage.ts');
+  const value={input:x.input,version:load('src/domain/examSearch/types.ts').ENGINE_VERSION,catalogVersion:'test-catalog',checkpoint};
+  const raw=storage.serializeSearchSession(value);assert.equal(JSON.parse(raw).checkpointEncoding,'lz-utf16-v1');
+  storedValues.set('twst-exam-resource-search-v1-session',raw);
+  const loaded=clone(storage.loadSearchSession());assert.deepEqual(loaded.checkpoint.parallel.checkpoints[0],x.checkpoint);
+  const y=await n3Run({checkpoint:loaded.checkpoint.parallel.checkpoints[0]});assert.deepEqual(y.calls,[3,4,5,6,7]);
+  assert.equal(y.checkpoint.pending.length,16);
+});
+test('N3 restore does not resurrect a pending row removed by checkpoint constraint filtering',async()=>{
+  const x=await n3Run({interruptTask:3});
+  const removed=x.checkpoint.pending[0].candidate.id;
+  x.checkpoint.pending=x.checkpoint.pending.filter(r=>r.candidate.id!==removed);
+  const y=await n3Run({checkpoint:x.checkpoint});
+  assert.equal(y.checkpoint.pending.length,15);
+  assert(!y.checkpoint.pending.some(r=>r.candidate.id===removed));
+  assert(!y.prepared.includes(removed));
+  assert.equal(new Set(y.checkpoint.pending.map(r=>r.candidate.id)).size,15);
+});

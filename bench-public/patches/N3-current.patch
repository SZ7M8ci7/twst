+// N3: no battle model, fixed task/candidate lists and unchanged ordinary quotas.
+async function n3Run({cap=20,checkpoint,interruptTask=-1,stopAfter=1,totalTasks=8,empty=false,emptyBefore=0,duplicate=false,stopOnMutation=false}={}) {
+  const input=fixture();input.additionalLevelCap=cap;input.preset.specialChallenges=[];
+  const template=generation.generateCandidates(input,generation.buildTasks(input,catalog)[0],catalog)[0];
+  const tasks=Array.from({length:totalTasks},(_,index)=>({index,cost:0}));
+  const original=generation.generateCandidatesAsync,originalNeighbors=generation.generateNeighbors,calls=[],prepared=[],seeds=[],mutations=[];let session,active;
+  generation.generateNeighbors=async()=>{mutations.push(clone(session.checkpoint()));session.stop();return [];};
+  generation.generateCandidatesAsync=async(_input,task)=>{
+    calls.push(task.index);
+    if(task.index===interruptTask){session.stop();return null;}
+    return empty||task.index<emptyBefore?[]:[0,1].map(i=>({...clone(template),id:duplicate&&i===1?'shared':`task-${task.index}-row-${i}`}));
+  };
+  const engine={prepare:async(_input,candidate)=>{active=candidate.id;prepared.push(active);},trial:seed=>{
+    seeds.push({seed,id:active});if(seeds.length===stopAfter)session.stop();return {score:1,retired:false,finishTurn:1};}};
+  try{
+    session=new SearchSession(input,catalog,engine,'n3-fixed',checkpoint);
+    session.tasksReady=true;session.tasks=tasks;session.knownTasksTotal=tasks.length;
+    session.diverseParents=()=>stopOnMutation?session.pool.slice(0,1):[];session.contenders=()=>[];
+    await session.run(10000,()=>{});
+    return {checkpoint:clone(session.checkpoint()),calls,prepared,seeds,input,mutations};
+  }finally{generation.generateCandidatesAsync=original;generation.generateNeighbors=originalNeighbors;}
+}
+test('N3 first8 tasks round-robin preserves candidate set and ordinary quota',async()=>{
+  const x=await n3Run({stopAfter:33});
+  assert.deepEqual(x.calls,[0,1,2,3,4,5,6,7]);
+  assert.equal(x.checkpoint.cursor,8);assert.equal(x.checkpoint.observedCursor,0);
+  assert.deepEqual(x.prepared,['task-0-row-0','task-1-row-0']);
+  assert.equal(x.checkpoint.pool[0].development.scores.length,32);
+  assert.equal(x.checkpoint.pending[0].development.scores.length,1);
+  const rows=[...x.checkpoint.pool,...x.checkpoint.pending];assert.equal(rows.length,16);
+  assert.equal(new Set(rows.map(r=>r.candidate.id)).size,16);
+  assert(rows.every(r=>variants.candidateSatisfiesConstraints(x.input,r.candidate,catalog)));
+});
+test('N3 partial generation stop persists completed tasks and restores without loss or repeat',async()=>{
+  const x=await n3Run({interruptTask:3});
+  assert.equal(x.checkpoint.cursor,3);assert.equal(x.checkpoint.observedCursor,0);
+  assert.equal(x.checkpoint.initialFrontier.ready,false);assert.equal(x.checkpoint.pending.length,6);
+  assert.equal(x.seeds.length,0);
+  const y=await n3Run({checkpoint:x.checkpoint,stopAfter:1});
+  assert.deepEqual(y.calls,[3,4,5,6,7]);assert.equal(y.checkpoint.pending.length,16);
+  assert.equal(y.checkpoint.pending[0].candidate.id,'task-0-row-0');
+  assert.equal(y.checkpoint.initialFrontier.ready,true);
+  const z=await n3Run({checkpoint:y.checkpoint,stopAfter:32});
+  assert.deepEqual(z.calls,[]);assert.deepEqual(z.prepared,['task-0-row-0','task-1-row-0']);
+  assert.equal(z.checkpoint.pool[0].development.scores.length,32);
+  assert.equal(z.checkpoint.pending[0].development.scores.length,1);
+  assert.equal(new Set([...y.seeds,...z.seeds].map(s=>s.seed)).size,33);
+});
